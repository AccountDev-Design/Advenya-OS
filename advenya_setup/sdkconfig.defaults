# =====================================================================
# ADVENYA setup · GUITION JC4880P443C_I_W (ESP32-P4) · ESP-IDF 5.5.5
# Los valores marcados [Flex] estan verificados en Flex OS Ultra.
# =====================================================================
CONFIG_IDF_TARGET="esp32p4"

# --- Revision del chip ------------------------------------------------
# IDF 5.5 compila por defecto SOLO para ESP32-P4 rev >= 3.0. Flex OS Ultra
# funciona en esta placa con el core Arduino 3.2.1 (IDF 5.4), que solo
# soporta revisiones < 3.0, asi que el chip de la placa de referencia es
# rev 0.x/1.x. El arranque imprime la revision real ("rev vX.Y"): si es
# >= 3.0, pon esta opcion a 'n' (ver docs/HARDWARE.md).
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
# [Flex] 360 MHz (maximo para rev < 3.0)
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y

# --- Flash [Flex]: 16 MB, QIO -----------------------------------------
# Flex usa 80 MHz. En IDF 5.5 los 80 MHz solo se ofrecen con revision minima
# >= v0.1; para no excluir chips v0.0 se deja el valor por defecto (40 MHz).
# Con un chip v0.1 o superior: CONFIG_ESP32P4_REV_MIN_1=y y FLASHFREQ_80M=y.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- PSRAM [Flex: habilitada] -----------------------------------------
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536

# --- Panel MIPI-DSI ---------------------------------------------------
# [Flex] Sin esto, escribir la flash (NVS) deja al puente DSI sin pixeles y
# el panel destella (FlexOS_Ultra_HAL.h, comentario "PANEL Y FLASH").
CONFIG_LCD_DSI_ISR_CACHE_SAFE=y
CONFIG_DMA2D_ISR_IRAM_SAFE=y
CONFIG_DMA2D_OPERATION_FUNC_IN_IRAM=y

# --- FreeRTOS / sistema -----------------------------------------------
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

# --- LVGL 9.2.2 (configuracion por Kconfig) ---------------------------
CONFIG_LV_CONF_SKIP=y
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_OS_NONE=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
# objetivo 30 FPS estables
CONFIG_LV_DEF_REFR_PERIOD=33
CONFIG_LV_DPI_DEF=160
CONFIG_LV_DRAW_SW_SHADOW_CACHE_SIZE=16
CONFIG_LV_DRAW_SW_CIRCLE_CACHE_SIZE=8
CONFIG_LV_CACHE_DEF_SIZE=0
CONFIG_LV_IMAGE_HEADER_CACHE_DEF_CNT=16
CONFIG_LV_DRAW_LAYER_SIMPLE_BUF_SIZE=49152
CONFIG_LV_USE_LOG=y
CONFIG_LV_LOG_LEVEL_WARN=y
CONFIG_LV_LOG_PRINTF=y
CONFIG_LV_USE_ASSERT_NULL=y
CONFIG_LV_USE_ASSERT_MALLOC=y
CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM=y
# solo los widgets que se usan
CONFIG_LV_USE_SPAN=y
CONFIG_LV_USE_LABEL=y
CONFIG_LV_USE_IMAGE=y
CONFIG_LV_USE_ANIMIMG=n
CONFIG_LV_USE_BAR=n
CONFIG_LV_USE_BUTTONMATRIX=n
CONFIG_LV_USE_CALENDAR=n
CONFIG_LV_USE_CANVAS=n
CONFIG_LV_USE_CHART=n
CONFIG_LV_USE_DROPDOWN=n
CONFIG_LV_USE_IMAGEBUTTON=n
CONFIG_LV_USE_KEYBOARD=n
CONFIG_LV_USE_LED=n
CONFIG_LV_USE_LINE=n
CONFIG_LV_USE_LIST=n
CONFIG_LV_USE_MENU=n
CONFIG_LV_USE_MSGBOX=n
CONFIG_LV_USE_ROLLER=n
CONFIG_LV_USE_SCALE=n
CONFIG_LV_USE_SLIDER=n
CONFIG_LV_USE_SPINBOX=n
CONFIG_LV_USE_SPINNER=n
CONFIG_LV_USE_SWITCH=n
CONFIG_LV_USE_TABLE=n
CONFIG_LV_USE_TABVIEW=n
CONFIG_LV_USE_TEXTAREA=n
CONFIG_LV_USE_TILEVIEW=n
CONFIG_LV_USE_WIN=n
CONFIG_LV_USE_ARC=n
CONFIG_LV_USE_CHECKBOX=n
# las fuentes son propias (Inter con Latin-1); Montserrat solo como reserva
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_14=y
CONFIG_LV_USE_THEME_DEFAULT=n
CONFIG_LV_USE_THEME_SIMPLE=n
CONFIG_LV_BUILD_EXAMPLES=n
